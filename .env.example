# Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git — only .env.example is committed

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Database (direct connection for pg Pool / FOR UPDATE transactions) ──
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ── Server ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Test Database ──────────────────────────────────────────────────────
# Uses same Supabase instance but with test-scoped data cleanup
TEST_DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
